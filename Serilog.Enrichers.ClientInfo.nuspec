<?xml version="1.0"?>
<package>
	<metadata>
		<id>Serilog.Enrichers.ClientInfo</id>
		<version>$version$</version>
		<title>Serilog.Enrichers.ClientInfo</title>
		<authors>mo.esmp</authors>
		<owners>mo.esmp</owners>
		<projectUrl>https://github.com/serilog-contrib/serilog-enrichers-clientinfo</projectUrl>
		<repository type="git" url="https://github.com/serilog-contrib/serilog-enrichers-clientinfo" />
		<license type="expression">MIT</license>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<description>Enrich logs with client IP, CorrelationId and HTTP request headers.</description>
		<readme>docs\README.md</readme>
		<icon>assets\icon.png</icon>
		<tags>serilog enrichers enricher ip correlation-id request header</tags>
		<copyright>© 2026 Serilog Contributors</copyright>
		<releaseNotes>
			- Add .NET 11 support.
			- Remove .NET 8 and .NET 9 targets.
			- Reference the Microsoft.AspNetCore.App shared framework instead of the Microsoft.AspNetCore.Http 2.x packages.
			- Limit the length of logged header values (1024) and accepted correlation ids (128), and remove control characters.
			- Fix lost log properties when several threads log within the same request.
			- Ipv4Only now logs IPv4-mapped IPv6 addresses as IPv4.
			- User claims are always read from the current principal.
		</releaseNotes>
		<dependencies>
			<group targetFramework=".NET10.0">
				<dependency id="Serilog" version="4.3.0" />
			</group>
			<group targetFramework=".NET11.0">
				<dependency id="Serilog" version="4.3.0" />
			</group>
		</dependencies>
		<frameworkReferences>
			<group targetFramework=".NET10.0">
				<frameworkReference name="Microsoft.AspNetCore.App" />
			</group>
			<group targetFramework=".NET11.0">
				<frameworkReference name="Microsoft.AspNetCore.App" />
			</group>
		</frameworkReferences>
	</metadata>
	<files>
		<file src="src\Serilog.Enrichers.ClientInfo\bin\release\net10.0\*" target="lib/net10.0" />
		<file src="src\Serilog.Enrichers.ClientInfo\bin\release\net11.0\*" target="lib/net11.0" />
		<file src="README.md" target="docs\" />
		<file src="icon.png" target="assets\" />
	</files>
</package>